{
  "name": "@postmark/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node build.mjs && wrangler deploy --dry-run --outdir dist/worker > /dev/null",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cf:dev": "wrangler d1 migrations apply postmark --local && wrangler dev --port 8788",
    "build:node": "node build.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@postmark/shared": "0.2.0",
    "better-sqlite3": "12.11.1",
    "hono": "4.13.8",
    "nanoid": "5.1.16",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "esbuild": "0.25.12",
    "wrangler": "^4.136.3"
  }
}
