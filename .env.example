# ---------- server ----------
PORT=8787
HOST=0.0.0.0
# Public base URL that recipients' mail clients will fetch pixels/links from (no trailing slash).
# For real Gmail testing this must be reachable from the internet (e.g. an https tunnel).
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_PATH=./data/postmark.db
# Comma-separated Chrome extension ids allowed by CORS. Empty = any chrome-extension:// origin (dev only).
EXTENSION_IDS=
# Only enable behind a reverse proxy you control.
TRUST_PROXY=false
# DEV ONLY: allow re-registering an existing email (rotates its token). Never enable in production.
DEV_ALLOW_TOKEN_ROTATION=false
# Comma-separated CIDRs treated as Apple Mail Privacy Protection egress.
APPLE_MPP_CIDRS=17.0.0.0/8
# Optional fixed salt (>=16 chars) for IP hashing; otherwise a random per-install salt is stored in the DB.
IP_HASH_SALT=
# Delete tracked messages and their events after N days (0 = keep forever).
RETENTION_DAYS=0
LOG_LEVEL=info

# ---------- extension (build-time, Vite) ----------
# Default server URL baked into the extension (changeable in Options).
VITE_POSTMARK_SERVER=http://localhost:8787
# InboxSDK app id — register a free one at https://www.inboxsdk.com/register
VITE_INBOXSDK_APP_ID=sdk_POSTMARK_DEV_PLACEHOLDER
